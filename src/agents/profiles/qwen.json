{
  "id": "qwen",
  "name": "Qwen Code",
  "connector": "acp",
  "command": "qwen --acp",
  "verified": true,
  "install": "npm install -g @qwen-code/qwen-code",
  "login": "qwen, then /auth",
  "requires": [
    "node"
  ],
  "env": {
    "QWEN_CODE_SYSTEM_SETTINGS_PATH": "${stateDir}/settings.json"
  },
  "options": {
    "files": {
      "${stateDir}/settings.json": {
        "tools": {
          "core": ["web_fetch", "web_search", "tool_search"]
        },
        "permissions": {
          "deny": ["run_shell_command", "write_file", "edit", "notebook_edit", "agent"]
        }
      }
    }
  }
}
