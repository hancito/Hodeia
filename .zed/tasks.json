// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.
// Windows tasks are driven by build-app.ps1 (MSVC + Ninja + vcpkg).
// Linux tasks use CMake + Ninja + clang.
[
  // ===== Windows =====
  // Each configuration has its own build dir (build/Release, build/Debug — same layout as Linux)
  // so switching between them never forces a full rebuild.
  // Release: /O2 /Ob2 + LTO (/GL, /LTCG).  Debug: /Od /Ob0 /RTC1, debug CRT and debug vcpkg DLLs.

  {
    "label": "Windows: Build & Run (Release)",
    "command": "cmd /c \"powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Windows/build-app.ps1 -Configuration Release && cd /d build\\Release && Hodeia.exe\"",
    "use_new_terminal": true,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["build_and_run", "windows", "release"],
  },

  {
    "label": "Windows: Build & Run (Debug)",
    "command": "cmd /c \"powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Windows/build-app.ps1 -Configuration Debug && cd /d build\\Debug && Hodeia.exe\"",
    "use_new_terminal": true,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["build_and_run", "windows", "debug"],
  },
  {
    "label": "Windows: Build Dependencies",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Windows/build-dependencies.ps1",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["build", "windows"],
  },
  {
    "label": "Windows: Package Installer (Inno Setup)",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Windows/package-app.ps1",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["package", "windows", "release"],
  },
  {
    "label": "Windows: Clean App Build",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Windows/clean-app.ps1",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["clean", "windows"],
  },
  {
    "label": "Windows: Clean Dependencies",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Windows/clean-deps.ps1",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["clean", "windows"],
  },

  // ===== Linux =====
  // Build dirs are split per configuration: build/Debug, build/Release, build/Sanitize.
  // Debug:    -DCMAKE_BUILD_TYPE=Debug, no LTO (LTO defeats debug stepping).
  // Release:  -DCMAKE_BUILD_TYPE=Release -DHODEIA_ENABLE_LTO=ON for optimisation.
  // Sanitize: Debug + ASan/UBSan. For TSan, reconfigure with -DHODEIA_SANITIZE=thread.
  {
    "label": "Linux: Configure Debug",
    "command": "cmake -S . -B build/Debug -G Ninja -DCMAKE_BUILD_TYPE=Debug -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["configure", "linux", "debug"],
  },
  {
    "label": "Linux: Build & Run (Debug)",
    "command": "cmake --build build/Debug && ./build/Debug/src/Hodeia",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["build_and_run", "linux", "debug"],
  },
  {
    "label": "Linux: Configure Release",
    "command": "cmake -S . -B build/Release -G Ninja -DCMAKE_BUILD_TYPE=Release -DHODEIA_ENABLE_LTO=ON -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["configure", "linux", "release"],
  },
  {
    "label": "Linux: Build & Run (Release)",
    "command": "cmake --build build/Release && ./build/Release/src/Hodeia",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["build_and_run", "linux", "release"],
  },
  {
    "label": "Linux: Configure Sanitize",
    "command": "cmake -S . -B build/Sanitize -G Ninja -DCMAKE_BUILD_TYPE=Debug -DHODEIA_SANITIZE=address,undefined -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["configure", "linux", "sanitize"],
  },
  {
    "label": "Linux: Build & Run (Sanitize)",
    "command": "cmake --build build/Sanitize && ./build/Sanitize/src/Hodeia",
    "cwd": "$ZED_WORKTREE_ROOT",
    // protect_shadow_gap=0: the CUDA driver maps memory inside ASan's shadow
    // gap; without it cuInit fails and ggml silently falls back to Vulkan.
    "env": {
      "ASAN_OPTIONS": "detect_leaks=0:halt_on_error=1:protect_shadow_gap=0",
      "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1",
    },
    "use_new_terminal": true,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["build_and_run", "linux", "sanitize"],
  },
  {
    "label": "Linux: Clean All",
    "command": "rm -rf build",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["clean", "linux"],
  },
]
