// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.
// Windows tasks are driven by build-app.ps1 (MSVC + Ninja + vcpkg).
// Linux tasks use CMake + Ninja + clang.
[
  // ===== Windows =====
  {
    "label": "Windows: Build (Release)",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Windows/build-app.ps1",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["build", "windows"],
  },
  {
    "label": "Windows: Run",
    "command": "cmd /c \"cd /d build-windows && Hodeia.exe\"",
    "use_new_terminal": true,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["run", "windows"],
  },
  {
    "label": "Windows: Build & Run",
    "command": "cmd /c \"powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Windows/build-app.ps1 && cd /d build-windows && Hodeia.exe\"",
    "use_new_terminal": true,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["build_and_run", "windows"],
  },
  {
    "label": "Windows: Build Debug",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& .\\scripts\\Windows\\build-app.ps1 -Configuration Debug\"",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["build", "windows"],
  },
  {
    "label": "Windows: Build Dependencies",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Windows/build-dependencies.ps1",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["build", "windows"],
  },
  {
    "label": "Windows: Clean App Build",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Windows/clean-app.ps1",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["clean", "windows"],
  },
  {
    "label": "Windows: Clean Dependencies",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Windows/clean-deps.ps1",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["clean", "windows"],
  },

  // ===== Linux =====
  // Build dirs are split per configuration: build/Debug and build/Release.
  // Debug:  -DCMAKE_BUILD_TYPE=Debug, no LTO (LTO defeats debug stepping).
  // Release: -DCMAKE_BUILD_TYPE=Release -DHODEIA_ENABLE_LTO=ON for optimisation.
  {
    "label": "Linux: Configure Debug",
    "command": "cmake -S . -B build/Debug -G Ninja -DCMAKE_BUILD_TYPE=Debug -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["build", "linux", "debug"],
  },
  {
    "label": "Linux: Configure Release",
    "command": "cmake -S . -B build/Release -G Ninja -DCMAKE_BUILD_TYPE=Release -DHODEIA_ENABLE_LTO=ON -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["build", "linux", "release"],
  },
  {
    "label": "Linux: Build Debug",
    "command": "cmake --build build/Debug",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["build", "linux", "debug"],
  },
  {
    "label": "Linux: Build Release",
    "command": "cmake --build build/Release",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["build", "linux", "release"],
  },
  {
    "label": "Linux: Build & Run (Debug)",
    "command": "cmake -S . -B build/Debug -G Ninja -DCMAKE_BUILD_TYPE=Debug -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ && cmake --build build/Debug && ./build/Debug/src/Hodeia",
    "use_new_terminal": true,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["build_and_run", "linux", "debug"],
  },
  {
    "label": "Linux: Build & Run (Release)",
    "command": "cmake -S . -B build/Release -G Ninja -DCMAKE_BUILD_TYPE=Release -DHODEIA_ENABLE_LTO=ON -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ && cmake --build build/Release && ./build/Release/src/Hodeia",
    "use_new_terminal": true,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["build_and_run", "linux", "release"],
  },
  {
    "label": "Linux: Run (Debug)",
    "command": "$ZED_WORKTREE_ROOT/build/Debug/src/Hodeia",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["run", "linux", "debug"],
  },
  {
    "label": "Linux: Run (Release)",
    "command": "$ZED_WORKTREE_ROOT/build/Release/src/Hodeia",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["run", "linux", "release"],
  },
  // Sanitize: Debug + ASan/UBSan in its own dir (build/Sanitize).
  // For TSan, reconfigure with -DHODEIA_SANITIZE=thread (exclusive with ASan).
  {
    "label": "Linux: Configure Sanitize (ASan+UBSan)",
    "command": "cmake -S . -B build/Sanitize -G Ninja -DCMAKE_BUILD_TYPE=Debug -DHODEIA_SANITIZE=address,undefined -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["build", "linux", "sanitize"],
  },
  {
    "label": "Linux: Configure & Build Sanitize",
    "command": "cmake -S . -B build/Sanitize -G Ninja -DCMAKE_BUILD_TYPE=Debug -DHODEIA_SANITIZE=address,undefined -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ && cmake --build build/Sanitize",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["build", "linux", "sanitize"],
  },
  {
    "label": "Linux: Build Sanitize",
    "command": "cmake --build build/Sanitize",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["build", "linux", "sanitize"],
  },
  {
    "label": "Linux: Run (Sanitize)",
    "command": "$ZED_WORKTREE_ROOT/build/Sanitize/src/Hodeia",
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "ASAN_OPTIONS": "detect_leaks=0:halt_on_error=1",
      "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1",
    },
    "use_new_terminal": true,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["run", "linux", "sanitize"],
  },
  {
    "label": "Linux: Run (Sanitize, leaks)",
    "command": "$ZED_WORKTREE_ROOT/build/Sanitize/src/Hodeia",
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "ASAN_OPTIONS": "detect_leaks=1",
      "UBSAN_OPTIONS": "print_stacktrace=1",
    },
    "use_new_terminal": true,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["run", "linux", "sanitize"],
  },
  {
    "label": "Linux: Clean",
    "command": "cmake --build build/Debug --target clean && cmake --build build/Release --target clean",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["clean", "linux"],
  },
  {
    "label": "Linux: Reset Build Dir",
    "command": "rm -rf build",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["clean", "linux"],
  },
]
