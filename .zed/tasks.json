// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.
[
  {
    "label": "CMake: Configure",
    "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug ",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
  },
  {
    "label": "CMake: Build",
    "command": "cmake --build build",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
  },
  {
    "label": "Build & Run",
    "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug   && cmake --build build && ./build/Paperize",
    "use_new_terminal": true,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["build_and_run"],
  },
  {
    "label": "CMake: Build Release",
    "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
  },
  {
    "label": "CMake: Clean",
    "command": "cmake --build build --target clean",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
  },
  {
    "label": "CMake: Reset Build Dir",
    "command": "rm -rf build",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
  },
  {
    "label": "Run: Paperize",
    "command": "./build/Paperize",
    "cwd": ".",
    "use_new_terminal": true,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
  },
]
