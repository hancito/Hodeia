// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.
// Windows tasks are driven by build-app.ps1 (MSVC + Ninja + vcpkg).
// Linux tasks use CMake + Ninja + clang.
[
  // ===== Windows =====
  {
    "label": "Windows: Build (Release)",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Windows/build-app.ps1",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["build", "windows"],
  },
  {
    "label": "Windows: Run",
    "command": "cmd /c \"cd /d build-windows && Hodeia.exe\"",
    "use_new_terminal": true,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["run", "windows"],
  },
  {
    "label": "Windows: Build & Run",
    "command": "cmd /c \"powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Windows/build-app.ps1 && cd /d build-windows && Hodeia.exe\"",
    "use_new_terminal": true,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["build_and_run", "windows"],
  },
  {
    "label": "Windows: Build Debug",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& .\\scripts\\Windows\\build-app.ps1 -Configuration Debug\"",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["build", "windows"],
  },
  {
    "label": "Windows: Build Dependencies",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Windows/build-dependencies.ps1",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["build", "windows"],
  },
  {
    "label": "Windows: Clean App Build",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Windows/clean-app.ps1",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["clean", "windows"],
  },
  {
    "label": "Windows: Clean Dependencies",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Windows/clean-deps.ps1",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["clean", "windows"],
  },

  // ===== Linux =====
  {
    "label": "Linux: Configure",
    "command": "cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Debug -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["build", "linux"],
  },
  {
    "label": "Linux: Build",
    "command": "cmake --build build",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["build", "linux"],
  },
  {
    "label": "Linux: Build & Run",
    "command": "cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Debug -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ && cmake --build build && ./build/src/Hodeia",
    "use_new_terminal": true,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["build_and_run", "linux"],
  },
  {
    "label": "Linux: Build Release",
    "command": "cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ && cmake --build build",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["build", "linux"],
  },
  {
    "label": "Linux: Clean",
    "command": "cmake --build build --target clean",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["clean", "linux"],
  },
  {
    "label": "Linux: Reset Build Dir",
    "command": "rm -rf build",
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["clean", "linux"],
  },
  {
    "label": "Linux: Run",
    "command": "./build/src/Hodeia",
    "cwd": ".",
    "use_new_terminal": true,
    "reveal": "always",
    "reveal_target": "dock",
    "show_summary": true,
    "show_command": true,
    "tags": ["run", "linux"],
  },
]
