// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "Debug Hodeia (GDB)",
    "process": "gdb",
    "adapter": "GDB",
    "process_args": ["./build/Debug/src/Hodeia", "--args"],
    "cwd": ".",

    "setup": [
      {
        "name": "build_project",
        "command": "cmake -S . -B build/Debug -G Ninja -DCMAKE_BUILD_TYPE=Debug -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ && cmake --build build/Debug",
      },
    ],
    "delays": {
      "pre_restart_runnable_delay_ms": 2000,
      "post_exit_delay_ms": 1000,
    },
  },
]
